# Server
PORT=3000
BASE_URL=http://localhost:3000

# Lead notification email
# Use your real receiving address here.
LEAD_EMAIL_TO=you@example.com
LEAD_EMAIL_FROM="Sol & Stone Website <no-reply@sandsps.com>"

# SMTP settings from your email provider.
# Examples: SendGrid, Mailgun, Postmark, Gmail app password, your hosting provider SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
